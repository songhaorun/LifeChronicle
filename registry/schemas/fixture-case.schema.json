{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifechronicle.io/registry/schemas/fixture-case.v1.json",
  "title": "LifeChronicle Registry validation fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "name",
    "base",
    "mutations",
    "expected"
  ],
  "properties": {
    "api_version": {
      "const": "lifechronicle.io/registry-fixture/v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 100
    },
    "base": {
      "type": "string",
      "pattern": "^(streams|metrics|templates)/[A-Za-z0-9._/-]+\\.yaml$",
      "maxLength": 300
    },
    "mutations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "path",
          "value"
        ],
        "properties": {
          "op": {
            "enum": [
              "set",
              "delete"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
            "maxLength": 300
          },
          "value": {}
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "error_contains"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "error_contains": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        }
      }
    }
  }
}
