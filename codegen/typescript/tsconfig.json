{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "paths": {
      "@bufbuild/protobuf": [
        "./node_modules/@bufbuild/protobuf/dist/esm/index.d.ts"
      ],
      "@bufbuild/protobuf/codegenv2": [
        "./node_modules/@bufbuild/protobuf/dist/esm/codegenv2/index.d.ts"
      ],
      "@bufbuild/protobuf/wkt": [
        "./node_modules/@bufbuild/protobuf/dist/esm/wkt/index.d.ts"
      ]
    }
  },
  "include": [
    "../../generated/typescript/**/*.ts"
  ]
}
