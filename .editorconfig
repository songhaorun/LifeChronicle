root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,markdown}]
indent_style = space
indent_size = 2

[*.{yaml,yml,json,jsonc}]
indent_style = space
indent_size = 2

[*.{toml,py,rs,kt,kts,java,gradle}]
indent_style = space
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,cjs,css,scss,html,proto}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
